{
  "env": {
    "ENABLE_TOOL_SEARCH": "false",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.git/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/site-packages/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Read(**/*.pyc)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/poetry.lock)",
      "Read(**/Cargo.lock)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "ai-relay-handoff": "off",
    "auto-session-summaries": "off",
    "loop": "off",
    "ponytail": "off",
    "ponytail-audit": "off",
    "ponytail-debt": "off",
    "ponytail-gain": "off",
    "ponytail-help": "off",
    "twc-auditor": "off",
    "video-vision": "off",
    "video-vision.bak": "off",
    "visiting-card-designer": "off",
    "ponytail-review": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/jarvis-auto-sync.py <<< $(cat)",
            "if": "Bash(cd ~/.jarvis|jarvis|python3 ~/.jarvis|git -C ~/.jarvis|~/.jarvis/jarvis|~/.local/bin/jarvis|launchctl load*jarvis|launchctl unload*jarvis|python3 ~/.jarvis/*|bash ~/.jarvis/*|chmod +x*)",
            "timeout": 60,
            "statusMessage": "Syncing Jarvis project...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/jarvis-auto-sync.py <<< $(cat)",
            "if": "Write|Edit(~/.jarvis/*)",
            "timeout": 60,
            "statusMessage": "Syncing Jarvis project...",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}'   || true ;; esac"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/token-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/model-routing.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/armaan/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "mcpServers": {
    "jarvis": {
      "command": "python3",
      "args": [
        "/Users/armaan/.jarvis/jarvis_mcp_server.py"
      ]
    },
    "memory-hub": {
      "command": "python3",
      "args": [
        "/Users/armaan/.claude/mcp-daemon/server.py"
      ]
    }
  },
  "skills": {
    "video-vision": {
      "name": "video-vision",
      "path": "/Users/armaan/.claude/skills/video-vision/SKILL.md",
      "description": "Comprehensive video generation vision pipeline \u2014 6-phase interrogation across 25 director-level categories before ANY generation script is written"
    }
  },
  "model": "opus"
}